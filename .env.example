# Copy to .env and fill in. .env is gitignored.

# Anthropic API key — required for Phase 3 onward
ANTHROPIC_API_KEY=sk-ant-...

# Model defaults
# Adjust to whatever's current in your Anthropic console; the scripts read this
# env var (defaulting to claude-sonnet-4-5 if unset).
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_HEAVY_MODEL=claude-opus-4-1

# Embedding model (we'll use voyage-3 or openai text-embedding-3-small in Phase 2)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# Phase 4 capstone — local infra
KAFKA_BOOTSTRAP=localhost:9092
VECTOR_DB_PATH=./data/chroma
